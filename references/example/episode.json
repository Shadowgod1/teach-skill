{
  "series": "Дела — обучение",
  "title": "Добавляем и закрываем задачи",
  "episodeLabel": "Урок 1",
  "url": "dela.app/tasks",
  "format": { "w": 1920, "h": 1080, "fps": 30 },
  "viewport": { "w": 1600, "h": 900 },
  "theme": { "accent": "#ff6b3d" },
  "scenes": [
    { "id": "intro", "type": "title", "kicker": "Дела · Урок 1", "title": "Добавляем и закрываем задачи",
      "subtitle": "Полторы минуты — и список дел под контролем.",
      "goals": ["Новая задача", "Отметка «готово»", "Фильтр готовых"],
      "lines": [{ "say": "В этом уроке научимся добавлять задачи, отмечать их выполненными и быстро находить готовые." }] },
    { "id": "add", "type": "screen", "shot": "home", "step": "Добавляем задачу",
      "lines": [
        { "say": "Все задачи живут на главном экране, в одном списке." },
        { "say": "Чтобы добавить новую, введите её название в поле сверху." },
        { "say": "И нажмите «Добавить». Задача сразу появится в конце списка." }
      ],
      "events": [
        { "do": "highlight", "box": "list", "at": "L0+0.3", "until": "L0e" },
        { "do": "click", "on": "title", "at": "L1+0.6" },
        { "do": "type", "box": "title", "text": "Купить молоко", "at": "L1+0.9", "until": "L2" , "size": 18},
        { "do": "shot", "src": "typed", "at": "L2" },
        { "do": "click", "on": "add", "at": "L2+0.9" },
        { "do": "shot", "src": "added", "at": "L2+1.05" },
        { "do": "highlight", "box": "new", "at": "L2+1.4", "dur": 2, "label": "Новая задача" }
      ] },
    { "id": "done", "type": "screen", "shot": "added", "step": "Отмечаем выполненной",
      "lines": [
        { "say": "Сделали дело? Поставьте галочку слева от задачи." },
        { "say": "Она зачеркнётся, но останется в списке." }
      ],
      "events": [
        { "do": "zoom", "box": "check", "scale": 1.9, "at": "L0+0.2", "until": "L1e" },
        { "do": "click", "on": "check", "at": "L0+1.8" },
        { "do": "shot", "src": "checked", "at": "L0+1.95" }
      ] },
    { "id": "filter", "type": "screen", "shot": "checked", "step": "Фильтр готовых",
      "lines": [
        { "say": "А чтобы увидеть только то, что уже сделано, переключите фильтр на «Готовые»." }
      ],
      "events": [
        { "do": "click", "on": "done", "at": "L0+2.6" },
        { "do": "shot", "src": "filtered", "at": "L0+2.75" },
        { "do": "highlight", "box": "list", "at": "L0+3.2", "dur": 1.8, "dim": true }
      ] },
    { "id": "code", "type": "code", "file": "index.html", "lang": "javascript", "reveal": "lines",
      "code": "document.getElementById('f').onsubmit = e => {\n  e.preventDefault();\n  const x = document.getElementById('title');\n  if (x.value.trim()) {\n    items.push({ t: x.value.trim(), d: false });\n    x.value = '';\n    draw();\n  }\n};",
      "lines": [
        { "say": "Для разработчиков: добавление — это обработчик отправки формы.", "sub": "Для разработчиков: добавление — это обработчик отправки формы." },
        { "say": "Пустые строки отбрасываются, а новая задача попадает в массив и список перерисовывается." }
      ],
      "events": [
        { "do": "focus", "lines": [4, 4], "at": "L1" },
        { "do": "focus", "lines": [5, 7], "at": "L1+2.4" }
      ] },
    { "id": "recap", "type": "recap", "kicker": "Итоги урока", "title": "Теперь вы умеете",
      "items": ["Добавлять задачи", "Отмечать их выполненными", "Показывать только готовые"],
      "lines": [
        { "say": "Итак, теперь вы умеете:" },
        { "say": "добавлять задачи," }, { "say": "отмечать их выполненными," }, { "say": "и показывать только готовые." },
        { "say": "В следующем уроке разберём сроки и напоминания." }
      ] }
  ]
}
